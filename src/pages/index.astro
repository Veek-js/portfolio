---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ExperienceList from '../components/ExperienceList.astro';
import StackSection from '../components/StackSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ArchiveSection from '../components/ArchiveSection.astro';
import Footer from '../components/Footer.astro';
import { getFeaturedProject, getSecondaryProjects } from '../data/projects';
import { experiences } from '../data/experience';
import { capabilities } from '../data/stack';
import { archiveProjects } from '../data/archive';

const navLinks = [
  { label: 'Work', href: '#work' },
  { label: 'Experience', href: '#experience' },
  { label: 'Stack', href: '#stack' },
  { label: 'About', href: '#about' },
  { label: 'Archive', href: '#archive' },
  { label: 'Contact', href: '#contact' },
];

const categories = [
  {
    num: '01',
    title: 'Minecraft',
    desc: 'Custom server systems, plugins and infrastructure for SMP communities.',
  },
  {
    num: '02',
    title: 'Discord',
    desc: 'Bots, automation, ticket systems and community management tools.',
  },
  {
    num: '03',
    title: 'Web',
    desc: 'Interfaces, dashboards, tools and full-stack applications.',
  },
  {
    num: '04',
    title: 'Infrastructure',
    desc: 'Deployment, servers, CI/CD pipelines and operations.',
  },
];

const featured = getFeaturedProject();
const secondary = getSecondaryProjects();
---

<Base title="Veekshith — Developer & Builder">
  <!-- Background -->
  <div class="home-bg" aria-hidden="true">
    <div class="home-bg__grid"></div>
    <div class="home-bg__glow"></div>
    <div class="home-bg__noise"></div>
  </div>

  <!-- Cursor -->
  <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>

  <Nav links={navLinks} status="available" />

  <main>
    <!-- ═══ HERO ═══ -->
    <section class="hero" id="hero">
      <div class="hero__inner">
        <!-- Left: Content -->
        <div class="hero__content">
          <div class="hero__label">
            <span class="hero__label-num">01</span>
            <span class="hero__label-line"></span>
            <span>Developer &middot; Builder &middot; Operator</span>
          </div>

          <h1 class="hero__name">VEEKSHITH</h1>

          <p class="hero__statement">
            I BUILD THINGS<br />
            THAT <span class="text-crimson">ACTUALLY RUN.</span>
          </p>

          <p class="hero__desc">
            Minecraft plugins, Discord bots, web tools, and the infrastructure 
            behind them. I ship code that powers real communities.
          </p>

          <div class="hero__tags">
            <span class="hero__tag">Java</span>
            <span class="hero__tag">TypeScript</span>
            <span class="hero__tag">Astro</span>
            <span class="hero__tag">Discord.js</span>
            <span class="hero__tag">Docker</span>
          </div>

          <div class="hero__actions">
            <Button href="#work" variant="primary" size="lg">View Work ↗</Button>
            <Button href="https://github.com/veekshith177-bot" variant="secondary" size="lg">GitHub ↗</Button>
          </div>
        </div>

        <!-- Right: System Panel -->
        <div class="hero__visual">
          <div class="sys-panel" id="sysPanel">
            <div class="sys-panel__header">
              <span class="sys-panel__title">System / 001</span>
              <div class="sys-panel__dots">
                <span class="sys-panel__dot"></span>
                <span class="sys-panel__dot"></span>
                <span class="sys-panel__dot sys-panel__dot--red"></span>
              </div>
            </div>

            <div class="sys-panel__body">
              <div class="sys-panel__row">
                <span class="sys-panel__key">Status</span>
                <span class="sys-panel__val">
                  <span class="sys-panel__status">
                    <span class="sys-panel__status-dot"></span>
                    Online
                  </span>
                </span>
              </div>
              <div class="sys-panel__row">
                <span class="sys-panel__key">Projects</span>
                <span class="sys-panel__val sys-panel__val--crimson">06</span>
              </div>
              <div class="sys-panel__row">
                <span class="sys-panel__key">Active</span>
                <span class="sys-panel__val">03</span>
              </div>
              <div class="sys-panel__row">
                <span class="sys-panel__key">Stack</span>
                <span class="sys-panel__val">04</span>
              </div>
            </div>

            <div class="sys-panel__section">
              <div class="sys-panel__section-label">Currently Building</div>
              <div class="sys-panel__section-value">Vanilla-Core</div>
            </div>

            <div class="sys-panel__section">
              <div class="sys-panel__section-label">Tech Stack</div>
              <div class="sys-panel__tech-row">
                <span class="sys-panel__tech">Java</span>
                <span class="sys-panel__tech">TypeScript</span>
                <span class="sys-panel__tech">Astro</span>
                <span class="sys-panel__tech">Docker</span>
              </div>
            </div>

            <div class="sys-panel__line"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ IDENTITY / QUICK PROOF ═══ -->
    <section class="identity reveal" id="about">
      <div class="container">
        <div class="identity__grid reveal-stagger">
          {categories.map((cat) => (
            <div class="identity__item" tabindex="0">
              <div class="identity__item-bar"></div>
              <div class="identity__item-glow"></div>
              <div class="identity__item-num">
                <span>{cat.num}</span>
              </div>
              <h3 class="identity__item-title">{cat.title}</h3>
              <p class="identity__item-desc">{cat.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ SELECTED WORK ═══ -->
    <section id="work">
      <!-- Section Header -->
      <div class="work-header">
        <div class="container">
          <div class="work-header__label">
            <span class="work-header__label-line"></span>
            <span>Selected Work</span>
          </div>
          <h2 class="work-header__title">THINGS I'VE<br />ACTUALLY BUILT.</h2>
          <p class="work-header__subtitle">
            Plugins running in production, bots handling real communities, 
            web tools people use daily. Not prototypes — products.
          </p>
        </div>
      </div>

      <!-- Featured Project -->
      {featured && <FeaturedProject project={featured} index={1} />}

      <!-- Secondary Projects -->
      {secondary.map((project, i) => (
        <ProjectRow project={project} index={i + 2} layout={i % 2 === 0 ? 'a' : 'b'} />
      ))}

      <!-- Archive Teaser -->
      <div class="archive-teaser reveal">
        <div class="container">
          <div class="archive-teaser__inner">
            <div class="archive-teaser__left">
              <div class="archive-teaser__label">
                <span class="archive-teaser__label-line"></span>
                <span>More Experiments</span>
              </div>
              <h3 class="archive-teaser__title">Some projects didn't make it this far.</h3>
              <p class="archive-teaser__desc">
                Old builds where the source drifted away — but the ideas stuck.
              </p>
            </div>
            <div>
              <Button href="#archive" variant="secondary">View Archive ↗</Button>
            </div>
          </div>
        </div>
      </div>

    </section>

    <!-- ═══ EXPERIENCE ═══ -->
    <section id="experience">
      <div class="exp-header">
        <div class="container">
          <div class="exp-header__label">
            <span class="exp-header__label-line"></span>
            <span>04 / Experience</span>
          </div>
          <h2 class="exp-header__title">WHERE I'VE<br />BUILT AND OPERATED.</h2>
          <p class="exp-header__subtitle">
            Running servers, building plugins, shipping bots — the work behind the projects.
          </p>
        </div>
      </div>

      <div class="container">
        <ExperienceList experiences={experiences} />
      </div>
    </section>

    <!-- ═══ STACK ═══ -->
    <section id="stack">
      <div class="stack-header reveal">
        <div class="container">
          <div class="stack-header__label">
            <span class="stack-header__label-line"></span>
            <span>05 / Stack</span>
          </div>
          <h2 class="stack-header__title">WHAT I<br />BUILD WITH.</h2>
          <p class="stack-header__subtitle">
            Tools change. The ability to build with them matters more.
          </p>
        </div>
      </div>

      <div class="container reveal">
        <StackSection capabilities={capabilities} />
      </div>
    </section>

    <!-- ═══ ABOUT ═══ -->
    <AboutSection />

    <!-- ═══ ARCHIVE ═══ -->
    <section id="archive">
      <div class="archive-header reveal">
        <div class="container">
          <div class="archive-header__label">
            <span class="archive-header__label-line"></span>
            <span>07 / Archive</span>
          </div>
          <h2 class="archive-header__title">THINGS THAT<br />DIDN'T STAY.</h2>
          <p class="archive-header__subtitle">
            Experiments, old builds, and things that taught me something.
          </p>
        </div>
      </div>

      <div class="container reveal">
        <ArchiveSection projects={archiveProjects} />
      </div>

      <!-- Contact Transition -->
      <div class="contact-transition reveal">
        <div class="container">
          <div class="contact-transition__label">
            <span class="contact-transition__label-line"></span>
            <span>08 / Contact</span>
          </div>
          <h2 class="contact-transition__title">LET'S BUILD<br />SOMETHING.</h2>
        </div>
      </div>
    </section>

    <!-- ═══ CONTACT ═══ -->
    <section class="featured-intro reveal" id="contact" style="padding-top: 0;">
      <div class="container">
        <div class="featured-intro__inner">
          <div class="featured-intro__left">
            <div class="featured-intro__label">
              <span class="featured-intro__label-line"></span>
              <span>Contact</span>
            </div>
            <h2 class="featured-intro__title">Let's build something.</h2>
            <p class="featured-intro__subtitle">
              Got a project in mind or just want to talk shop? I'm always open to 
              new collaborations and interesting problems.
            </p>
          </div>
          <div class="featured-intro__cta" style="display: flex; gap: var(--space-3);">
            <Button href="mailto:veekshith177@gmail.com" variant="primary">Email</Button>
            <Button href="https://discord.com/users/1322117319060619307" variant="secondary">Discord</Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
  // ── Hero entrance animation ──
  (function() {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const hero = document.getElementById('hero');
        if (hero) hero.classList.add('hero--loaded');
      });
    });
  })();

  // ── System panel mouse parallax ──
  (function() {
    const panel = document.getElementById('sysPanel');
    if (!panel) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    let rafId = null;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    document.addEventListener('mousemove', (e) => {
      const rect = panel.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      targetX = (e.clientX - centerX) / rect.width * 6;
      targetY = (e.clientY - centerY) / rect.height * 6;
    }, { passive: true });

    function animate() {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      panel.style.transform = `perspective(800px) rotateY(${currentX * 0.4}deg) rotateX(${-currentY * 0.4}deg) translateX(${currentX}px) translateY(${currentY}px)`;

      rafId = requestAnimationFrame(animate);
    }

    document.addEventListener('mouseenter', () => {
      if (!rafId) rafId = requestAnimationFrame(animate);
    }, { passive: true });

    document.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    }, { passive: true });
  })();

  // ── Custom cursor ──
  (function() {
    const dot = document.getElementById('cursorDot');
    if (!dot) return;

    const isFinePointer = window.matchMedia('(pointer: fine)').matches;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!isFinePointer || prefersReduced) {
      dot.style.display = 'none';
      return;
    }

    let cursorX = 0;
    let cursorY = 0;
    let dotX = 0;
    let dotY = 0;

    document.addEventListener('mousemove', (e) => {
      cursorX = e.clientX;
      cursorY = e.clientY;
    }, { passive: true });

    function animateCursor() {
      dotX += (cursorX - dotX) * 0.15;
      dotY += (cursorY - dotY) * 0.15;
      dot.style.left = dotX + 'px';
      dot.style.top = dotY + 'px';
      requestAnimationFrame(animateCursor);
    }
    animateCursor();

    // Hover detection on interactive elements
    const interactiveSelector = 'a, button, [tabindex], .identity__item, .btn';
    document.querySelectorAll(interactiveSelector).forEach((el) => {
      el.addEventListener('mouseenter', () => dot.classList.add('cursor--hover'));
      el.addEventListener('mouseleave', () => dot.classList.remove('cursor--hover'));
    });
  })();

  // ── Identity section keyboard support ──
  (function() {
    document.querySelectorAll('.identity__item').forEach((item) => {
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          item.classList.toggle('identity__item--active');
        }
      });
    });
  })();
  </script>
</Base>
