---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Not Found — Veekshith" description="This project doesn't exist.">
  <div class="home-bg" aria-hidden="true">
    <div class="home-bg__grid"></div>
    <div class="home-bg__glow"></div>
    <div class="home-bg__noise"></div>
  </div>

  <nav class="nav">
    <div class="nav__inner">
      <a href="/" class="nav__logo">veekshith<span>.</span></a>
      <a href="/" class="project-detail__back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        Back to work
      </a>
    </div>
  </nav>

  <div class="not-found">
    <div class="not-found__inner">
      <div class="not-found__code">404</div>
      <h1 class="not-found__title">Project Not Found</h1>
      <p class="not-found__desc">
        This project doesn't exist or may have been moved.
      </p>
      <Button href="/#work" variant="primary" size="lg">Back to Work ↗</Button>
    </div>
  </div>
</Base>
