---
const metadata = [
  { label: 'Based', value: 'India' },
  { label: 'Focus', value: 'Software / Communities' },
  { label: 'Building', value: 'Minecraft · Discord · Web' },
];

const workflow = [
  {
    num: '01',
    title: 'Build',
    desc: 'Start with something useful, not something impressive.',
  },
  {
    num: '02',
    title: 'Test',
    desc: 'Use the thing I built and find where it breaks.',
  },
  {
    num: '03',
    title: 'Refine',
    desc: 'Remove unnecessary complexity and improve the experience.',
  },
];
---

<section id="about">
  <div class="about-header reveal">
    <div class="container">
      <div class="about-header__label">
        <span class="about-header__label-line"></span>
        <span>06 / About</span>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="about-layout">
      <div class="about-layout__left reveal">
        <h2 class="about-headline">
          <span class="about-headline__line">THE PERSON</span>
          <span class="about-headline__line">BEHIND THE</span>
          <span class="about-headline__line"><span class="about-headline__accent">PROJECTS.</span></span>
        </h2>
      </div>

      <div class="about-layout__right">
        <p class="about-intro reveal">
          I'm <strong>Veekshith</strong>.
        </p>

        <p class="about-description reveal">
          I build software around online communities — Minecraft systems, Discord tools, web applications, and the infrastructure that keeps them running.
        </p>

        <p class="about-description reveal">
          I like taking an idea from "this would be useful" to something people can actually use.
        </p>

        <div class="about-meta reveal">
          {metadata.map((item) => (
            <div class="about-meta__item">
              <span class="about-meta__label">{item.label}</span>
              <span class="about-meta__value">{item.value}</span>
            </div>
          ))}
        </div>

        <div class="about-philosophy reveal">
          <p class="about-philosophy__text">
            I care more about useful software than impressive-looking software.
          </p>
        </div>

        <div class="about-work reveal">
          <h3 class="about-work__title">How I Work</h3>
          <div class="about-work__list">
            {workflow.map((step) => (
              <div class="about-work__step">
                <span class="about-work__num">{step.num}</span>
                <div>
                  <div class="about-work__step-title">{step.title}</div>
                  <p class="about-work__step-desc">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
