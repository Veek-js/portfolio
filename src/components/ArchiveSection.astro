---
import type { ArchiveProject } from '../data/archive';

interface Props {
  projects: ArchiveProject[];
}

const { projects } = Astro.props;
---

<div class="archive-list">
  {projects.map((project) => (
    <div class="archive-item">
      <button
        class="archive-trigger"
        aria-expanded="false"
        aria-controls={`archive-panel-${project.id}`}
        data-archive-trigger={project.id}
      >
        <span class="archive-item__indicator" aria-hidden="true"></span>
        <span class="archive-item__num">{project.num}</span>
        <div class="archive-item__info">
          <div class="archive-item__title">{project.title}</div>
          <div class="archive-item__category">{project.category}</div>
        </div>
        <span class={`archive-item__status archive-item__status--${project.status}`}>
          {project.status}
        </span>
        <span class="archive-item__year">{project.year}</span>
        <svg class="archive-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
      </button>

      <div
        class="archive-panel"
        id={`archive-panel-${project.id}`}
        aria-hidden="true"
        role="region"
      >
        <div class="archive-panel__inner">
          <div>
            <p class="archive-panel__desc">{project.description}</p>
            {project.reason && (
              <p class="archive-panel__reason">{project.reason}</p>
            )}
            <div class="archive-panel__tech">
              {project.technologies.map((tech, i) => (
                <>
                  <span class="archive-panel__tech-item">{tech}</span>
                  {i < project.technologies.length - 1 && (
                    <span class="archive-panel__tech-sep">·</span>
                  )}
                </>
              ))}
            </div>
          </div>

          {project.github && (
            <a href={project.github} class="archive-panel__link" target="_blank" rel="noopener noreferrer">
              GitHub
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  function initArchive() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('[data-archive-trigger]');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.archiveTrigger!;
        const panel = document.getElementById(`archive-panel-${id}`);
        if (!panel) return;

        const expanded = trigger.getAttribute('aria-expanded') === 'true';

        // Close all others
        triggers.forEach((t) => {
          if (t !== trigger) {
            t.setAttribute('aria-expanded', 'false');
            const otherPanel = document.getElementById(`archive-panel-${t.dataset.archiveTrigger!}`);
            if (otherPanel) otherPanel.setAttribute('aria-hidden', 'true');
          }
        });

        trigger.setAttribute('aria-expanded', String(!expanded));
        panel.setAttribute('aria-hidden', String(expanded));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initArchive);
</script>
