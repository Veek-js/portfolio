---
import type { Project } from '../data/projects';

interface Props {
  visual: Project['visual'];
  title: string;
  heroImage?: string;
}

const { visual, title, heroImage } = Astro.props;
---

{heroImage ? (
  <img
    src={heroImage}
    alt={`${title} screenshot`}
    class="cs-hero__img"
    loading="eager"
    decoding="async"
    width="1280"
    height="720"
  />
) : (
<div class={`project-visual__content project-visual--${visual}`} aria-label={`${title} preview`}>
  {visual === 'terminal' && (
    <div class="pv-header">
      <span class="pv-dot"></span>
      <span class="pv-dot"></span>
      <span class="pv-dot pv-dot--red"></span>
      <span class="pv-title">vanilla-core — terminal</span>
    </div>
    <div class="pv-line"><span class="pv-prompt">$</span> <span class="pv-cmd">./gradlew build</span></div>
    <div class="pv-line"><span class="pv-success">✓</span> <span class="pv-output">BUILD SUCCESSFUL in 4s</span></div>
    <div class="pv-line"><span class="pv-prompt">$</span> <span class="pv-cmd">java -jar Vanilla-Core.jar</span></div>
    <div class="pv-line"><span class="pv-accent">[Vanilla-Core]</span> <span class="pv-output">Loading essentials...</span></div>
    <div class="pv-line"><span class="pv-accent">[Vanilla-Core]</span> <span class="pv-output">Homes system — <span class="pv-success">ready</span></span></div>
    <div class="pv-line"><span class="pv-accent">[Vanilla-Core]</span> <span class="pv-output">Economy — <span class="pv-success">ready</span></span></div>
    <div class="pv-line"><span class="pv-accent">[Vanilla-Core]</span> <span class="pv-output">Staff tools — <span class="pv-success">ready</span></span></div>
    <div class="pv-bar">
      <span class="pv-bar-segment pv-bar-segment--active" style="width: 40%"></span>
      <span class="pv-bar-segment" style="width: 25%"></span>
      <span class="pv-bar-segment" style="width: 15%"></span>
      <span class="pv-bar-segment" style="width: 10%"></span>
    </div>
  )}

  {visual === 'discord' && (
    <div class="pv-header">
      <span class="pv-hash">#</span>
      <span class="pv-channel">support-tickets</span>
    </div>
    <div class="pv-msg">
      <div class="pv-avatar"></div>
      <div class="pv-msg-content">
        <div class="pv-msg-name">Apex Building Bot</div>
        <div class="pv-msg-text">New ticket opened — <strong>General Support</strong></div>
      </div>
    </div>
    <div class="pv-msg">
      <div class="pv-avatar" style="background: #2d5a27;"></div>
      <div class="pv-msg-content">
        <div class="pv-msg-name" style="color: #57c957;">Staff</div>
        <div class="pv-msg-text">Ticket claimed. How can I help?</div>
      </div>
    </div>
    <div class="pv-ticket">
      <div class="pv-ticket-icon"></div>
      <span class="pv-ticket-text">Ticket Panel — 5 categories</span>
    </div>
  )}

  {visual === 'browser' && (
    <div class="pv-chrome">
      <div class="pv-dots">
        <span class="pv-dot"></span>
        <span class="pv-dot"></span>
        <span class="pv-dot"></span>
      </div>
      <div class="pv-url">minecraft-skin-gallery.netlify.app</div>
    </div>
    <div class="pv-viewport">
      <div class="pv-skin-frame">
        <div class="pv-skin-head"></div>
        <div class="pv-skin-body"></div>
        <div class="pv-skin-legs">
          <div class="pv-skin-leg"></div>
          <div class="pv-skin-leg"></div>
        </div>
      </div>
      <span class="pv-label">3D Preview</span>
      <div class="pv-anim-row">
        <span class="pv-anim">Walk</span>
        <span class="pv-anim pv-anim--active">Run</span>
        <span class="pv-anim">Fly</span>
        <span class="pv-anim">Wave</span>
      </div>
    </div>
  )}

  {visual === 'code' && (
    <div class="pv-header">
      <span class="pv-dot"></span>
      <span class="pv-dot"></span>
      <span class="pv-dot"></span>
      <span class="pv-filename">DonutTools.java</span>
    </div>
    <div class="pv-code">
      <div><span class="pv-kw">public class</span> <span class="pv-fn">ShardPicaxe</span> {'{'}</div>
      <div>&nbsp;&nbsp;<span class="pv-cm">// 9x9 area break</span></div>
      <div>&nbsp;&nbsp;<span class="pv-kw">private int</span> radius = <span class="pv-num">4</span>;</div>
      <div>&nbsp;&nbsp;<span class="pv-kw">private long</span> cooldown = <span class="pv-num">30000</span>;</div>
      <div>&nbsp;&nbsp;</div>
      <div>&nbsp;&nbsp;<span class="pv-kw">public void</span> <span class="pv-fn">breakArea</span>(Block center) {'{'}</div>
      <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="pv-kw">for</span> (Block block : getNearby(center)) {'{'}</div>
      <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;block.<span class="pv-fn">breakNaturally</span>();</div>
      <div>&nbsp;&nbsp;&nbsp;&nbsp;{'}'}</div>
      <div>&nbsp;&nbsp;{'}'}</div>
      <div>{'}'}</div>
    </div>
  )}
</div>
)}
