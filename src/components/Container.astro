---
interface Props {
  class?: string;
  sm?: boolean;
  md?: boolean;
  lg?: boolean;
}

const { class: className = '', sm, md, lg, ...rest } = Astro.props;

const maxWidth = sm ? 'container--sm' : md ? 'container--md' : '';
const classes = ['container', maxWidth, className].filter(Boolean).join(' ');
---

<div class={classes} {...rest}>
  <slot />
</div>
