---
interface Props {
  variant?: 'default' | 'crimson' | 'success' | 'warning' | 'info';
  size?: 'sm' | 'md';
  dot?: boolean;
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  dot = false,
  class: className = '',
  ...rest
} = Astro.props;

const classes = [
  'badge',
  `badge--${variant}`,
  size === 'sm' && 'badge--sm',
  dot && 'badge--dot',
  className,
].filter(Boolean).join(' ');
---

<span class={classes} {...rest}>
  <slot />
</span>
