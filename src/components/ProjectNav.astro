---
import type { Project } from '../data/projects';

interface Props {
  prev: Project | null;
  next: Project | null;
}

const { prev, next } = Astro.props;
---

<nav class="cs-nav" aria-label="Project navigation">
  <div class="container">
    <div class="cs-nav__inner">
      {prev ? (
        <a href={`/projects/${prev.slug}`} class="cs-nav__link">
          <span class="cs-nav__link-label">← Previous</span>
          <span class="cs-nav__link-title">{prev.title}</span>
          <span class="cs-nav__link-category">{prev.category}</span>
        </a>
      ) : <div />}
      {next ? (
        <a href={`/projects/${next.slug}`} class="cs-nav__link cs-nav__link--next">
          <span class="cs-nav__link-label">Next →</span>
          <span class="cs-nav__link-title">{next.title}</span>
          <span class="cs-nav__link-category">{next.category}</span>
        </a>
      ) : <div />}
    </div>
    <div class="cs-nav__all">
      <a href="/#work" class="project-row__arrow">
        All Work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</nav>
